{
  "name": "@blobz/react",
  "version": "0.1.1",
  "description": "React components for generated and custom Blobz avatars.",
  "keywords": [
    "avatar",
    "blob",
    "react",
    "svg"
  ],
  "homepage": "https://blobz.lirena.in",
  "bugs": {
    "url": "https://github.com/lirena00/blobz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lirena00/blobz.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js",
      "default": "./dist/avatar.js"
    },
    "./custom": {
      "types": "./dist/custom-avatar.d.ts",
      "import": "./dist/custom-avatar.js",
      "default": "./dist/custom-avatar.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/avatar.tsx src/custom-avatar.tsx --format esm --dts --clean --sourcemap --external react --external @blobz/avatar-core",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "bun run check-types && bun run test && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@blobz/avatar-core": "^0.1.1"
  },
  "devDependencies": {
    "@blobz/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
