{
  "name": "@blobz/react",
  "version": "0.1.0",
  "description": "React components for generated and custom Blobz avatars.",
  "keywords": [
    "avatar",
    "blob",
    "react",
    "svg"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/avatar.tsx",
      "default": "./src/avatar.tsx"
    },
    "./builder": {
      "types": "./src/avatar-builder.tsx",
      "default": "./src/avatar-builder.tsx"
    },
    "./builder.css": "./src/avatar-builder.css",
    "./palette-picker": {
      "types": "./src/palette-picker.tsx",
      "default": "./src/palette-picker.tsx"
    },
    "./custom": {
      "types": "./src/custom-avatar.tsx",
      "default": "./src/custom-avatar.tsx"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@blobz/avatar-core": "workspace:*",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@blobz/config": "workspace:*",
    "@happy-dom/global-registrator": "^20.14.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
