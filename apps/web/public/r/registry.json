      "files": [
        {
          "path": "src/registry/blobz/avatar-builder.tsx",
          "type": "registry:component",
          "target": "components/blobz/avatar-builder.tsx"
        },
        {
          "path": "src/registry/blobz/avatar-palette-picker.tsx",
          "type": "registry:component",
          "target": "components/blobz/avatar-palette-picker.tsx"
        },
        {
          "path": "src/registry/blobz/avatar-builder.css",
          "type": "registry:style",
          "target": "components/blobz/avatar-builder.css"
        }
      ]
    },
    {
      "name": "avatar-palette-picker",
      "type": "registry:component",
      "title": "Avatar Palette Picker",
      "description": "A controlled two-colour palette editor for Blobz avatars.",
      "dependencies": ["@blobz/avatar-core"],
      "files": [
        {
          "path": "src/registry/blobz/avatar-palette-picker.tsx",
          "type": "registry:component",
          "target": "components/blobz/avatar-palette-picker.tsx"
        },
        {
          "path": "src/registry/blobz/avatar-builder.css",
          "type": "registry:style",
          "target": "components/blobz/avatar-builder.css"
