{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "build": "bun run registry:build && next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev --port 3001",
    "docs:generate-api": "bun scripts/generate-api-docs.ts",
    "env:generate": "varlock codegen",
    "registry:build": "shadcn build registry.json --cwd ../.. --output apps/web/public/r && biome format --write public/r",
    "registry:validate": "shadcn registry validate registry.json --cwd ../..",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@blobz/auth": "workspace:*",
    "@blobz/avatar-core": "workspace:*",
    "@blobz/db": "workspace:*",
    "@blobz/react": "workspace:*",
    "@blobz/ui": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-form": "^1.33.5",
    "@varlock/nextjs-integration": "1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "catalog:",
    "fflate": "^0.8.3",
    "fumadocs-core": "^16.17.1",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-openapi": "^12.4.1",
    "fumadocs-ui": "^16.17.1",
    "lucide-react": "catalog:",
    "next": "16.4.3",
    "next-themes": "catalog:",
    "prism-react-renderer": "^2.4.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "sonner": "catalog:",
    "tw-animate-css": "^1.4.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blobz/config": "workspace:*",
    "@happy-dom/global-registrator": "^20.14.6",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "^1.4.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "1.4.2",
    "tailwindcss": "catalog:",
