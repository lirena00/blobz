          "blob-avatar-status-online": "oklch(0.627 0.194 149.214)"
        },
        "dark": {
          "blob-avatar-status-away": "oklch(0.828 0.189 84.429)",
          "blob-avatar-status-online": "oklch(0.723 0.219 149.579)"
        }
      },
      "files": [
        {
          "path": "avatar-status.tsx",
          "type": "registry:component",
          "target": "@components/blobz/avatar-status.tsx"
